  "components": {
    "schemas": {
      "ExerciseCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Exercise name.",
            "examples": [
              "Bench Press"
            ]
          },
          "muscle_group": {
            "$ref": "#/components/schemas/MuscleGroup",
            "description": "Primary muscle group targeted."
          }
        },
        "type": "object",
        "required": [
          "name",
          "muscle_group"
        ],
        "title": "ExerciseCreate",
        "description": "Payload for creating a new exercise."
      },
      "ExerciseRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Unique identifier.",
            "examples": [
              1
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Exercise name.",
            "examples": [
              "Bench Press"
            ]
          },
          "muscle_group": {
            "$ref": "#/components/schemas/MuscleGroup",
            "description": "Primary muscle group targeted."
          },
          "created_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By",
            "description": "Id of the user who created this exercise, if any."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When the exercise was created."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "muscle_group",
          "created_at"
        ],
        "title": "ExerciseRead",
        "description": "An exercise as returned by the API."
      },
      "ExerciseUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Exercise name.",
            "examples": [
              "Bench Press"
            ]
          },
          "muscle_group": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MuscleGroup"
              },
              {
                "type": "null"
              }
            ],
            "description": "Primary muscle group targeted."
          }
        },
        "type": "object",
        "title": "ExerciseUpdate",
        "description": "Payload for updating an exercise. Omitted fields are left unchanged."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service status.",
            "examples": [
              "ok"
            ]
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Active environment name.",
            "examples": [
              "development"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "API version.",
            "examples": [
              "0.1.0"
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Service health status."
      },
      "Language": {
        "type": "string",
        "enum": [
          "english",
          "german"
        ],
        "title": "Language"
      },
      "MuscleGroup": {
        "type": "string",
        "enum": [
          "chest",
          "back",
          "shoulders",
          "biceps",
          "triceps",
          "abs",
          "calves",
          "quads"
        ],
        "title": "MuscleGroup"
      },
      "Page_ExerciseRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExerciseRead"
            },
            "type": "array",
            "title": "Items",
            "description": "The items on this page."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total number of items across all pages."
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Current page number (1-indexed).",
            "examples": [
              1
            ]
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "description": "Maximum number of items per page.",
            "examples": [
              20
            ]
          },
          "pages": {
