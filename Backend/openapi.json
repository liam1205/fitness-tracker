    "/api/v1/workout-sessions/active": {
      "get": {
        "tags": [
          "workout-sessions"
        ],
        "summary": "List active workout sessions",
        "description": "Return the current user's workout sessions that haven't been completed yet.",
        "operationId": "list_active_workout_sessions",
        "responses": {
          "200": {
