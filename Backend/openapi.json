    "/api/v1/exercises": {
      "get": {
        "tags": [
          "exercises"
        ],
        "summary": "List exercises",
        "description": "Return a page of the current user's exercises.",
        "operationId": "list_exercises",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed).",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Number of items per page.",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Number of items per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
