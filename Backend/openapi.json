{
  "openapi": "3.1.0",
  "info": {
    "title": "Web App Template API",
    "description": "Backend API for the web app template.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Return the current service status. Useful for uptime checks and readiness probes.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register and sign in",
        "description": "Create a new account and start a session (sets the encrypted cookie).",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in",
        "description": "Verify credentials and start a session (sets the encrypted cookie).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out",
        "description": "End the current session by clearing the cookie.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get the current user",
        "description": "Return the signed-in user and refresh the session window.",
        "operationId": "read_current_user",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "List users",
        "description": "Return all users.",
        "operationId": "list_users",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserRead"
                  },
                  "type": "array",
                  "title": "Response List Users"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create a user",
        "description": "Register a new user. The password is hashed before storage.",
        "operationId": "create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{user_id}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get a user",
        "description": "Return a single user by id.",
        "operationId": "get_user",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exercises": {
      "get": {
        "tags": [
          "exercises"
        ],
        "summary": "List exercises",
        "description": "Return a page of the current user's exercises.",
        "operationId": "list_exercises",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed).",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Number of items per page.",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Number of items per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ExerciseRead_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExerciseRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Unique identifier.",
            "examples": [
              1
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Exercise name.",
            "examples": [
              "Bench Press"
            ]
          },
          "muscle_group": {
            "$ref": "#/components/schemas/MuscleGroup",
            "description": "Primary muscle group targeted."
          },
          "created_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By",
            "description": "Id of the user who created this exercise, if any."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When the exercise was created."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "muscle_group",
          "created_at"
        ],
        "title": "ExerciseRead",
        "description": "An exercise as returned by the API."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service status.",
            "examples": [
              "ok"
            ]
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Active environment name.",
            "examples": [
              "development"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "API version.",
            "examples": [
              "0.1.0"
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Service health status."
      },
      "MuscleGroup": {
        "type": "string",
        "enum": [
          "chest",
          "back",
          "shoulders",
          "biceps",
          "triceps",
          "abs",
          "calves",
          "quads"
        ],
        "title": "MuscleGroup"
      },
      "Page_ExerciseRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExerciseRead"
            },
            "type": "array",
            "title": "Items",
            "description": "The items on this page."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total number of items across all pages."
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Current page number (1-indexed).",
            "examples": [
              1
            ]
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "description": "Maximum number of items per page.",
            "examples": [
              20
            ]
          },
          "pages": {
            "type": "integer",
            "title": "Pages",
            "description": "Total number of pages."
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "pages"
        ],
        "title": "Page[ExerciseRead]"
      },
      "UserCreate": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "User email address.",
            "examples": [
              "user@example.com"
            ]
          },
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "title": "First Name",
            "description": "Given name.",
            "examples": [
              "Jane"
            ]
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "title": "Last Name",
            "description": "Family name.",
            "examples": [
              "Doe"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "description": "Plaintext password (min 8 characters)."
          }
        },
        "type": "object",
        "required": [
          "email",
          "first_name",
          "last_name",
          "password"
        ],
        "title": "UserCreate",
        "description": "Payload for creating a user. The password is stored hashed, never in plaintext."
      },
      "UserLogin": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "User email address.",
            "examples": [
              "user@example.com"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Plaintext password."
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "UserLogin",
        "description": "Credentials for signing in. Users authenticate by email."
      },
      "UserRead": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "User email address.",
            "examples": [
              "user@example.com"
            ]
          },
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "title": "First Name",
            "description": "Given name.",
            "examples": [
              "Jane"
            ]
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "title": "Last Name",
            "description": "Family name.",
            "examples": [
              "Doe"
            ]
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Unique identifier.",
            "examples": [
              1
            ]
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "description": "Whether the account is active."
          },
          "is_superuser": {
            "type": "boolean",
            "title": "Is Superuser",
            "description": "Whether the account has elevated privileges."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When the account was created."
          }
        },
        "type": "object",
        "required": [
          "email",
          "first_name",
          "last_name",
          "id",
          "is_active",
          "is_superuser",
          "created_at"
        ],
        "title": "UserRead",
        "description": "A user as returned by the API. Never includes the password hash."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
