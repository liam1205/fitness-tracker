# Copy to .env and adjust as needed.
PROJECT_NAME="Web App Template API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database — async SQLAlchemy URL. A managed provider's postgresql:// or
# postgres:// string (with ?sslmode=...) is accepted and rewritten for asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DB_ECHO=false

# Allowed CORS origins: a JSON array, a comma-separated list, or one origin.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Auth — secret used to encrypt the session cookie. Any sufficiently random
# string works (it is hashed into a Fernet key); a real Fernet key is used as-is.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The app refuses to start with this placeholder unless ENVIRONMENT=development.
SECRET_KEY=changeme-generate-a-real-fernet-key
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE_SECONDS=1800
# Set to true in production (requires HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
